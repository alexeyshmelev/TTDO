<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>TrustTunnel server dependency licenses</title>
</head>
<body>
  <h1>TrustTunnel server dependency licenses</h1>
  {{#each licenses}}
  <section>
    <h2>{{name}} ({{id}})</h2>
    <p>Used by:</p>
    <ul>
      {{#each used_by}}
      <li>{{crate.name}} {{crate.version}}</li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  </section>
  {{/each}}
</body>
</html>
